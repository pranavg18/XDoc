CC      = gcc
CFLAGS  = -Wall -Wextra -g -std=c11

LIBS    = -lpthread

## server
SERVER_SRCS = server_main_mac.c \
              server.c          \
              crdt.c            \
              persistence.c     \
              network.c         \
              auth.c

SERVER_OUT  = server

## client
CLIENT_SRCS = client_main.c \
              client.c      \
              crdt.c        \
              network.c     \
              terminal_mac.c

CLIENT_OUT  = client

## logger
LOGGER_SRCS = logger.c
LOGGER_OUT  = logger

## convergence test (standalone — no networking)
TEST_SRCS = crdt_test.c crdt.c
TEST_OUT  = crdt_test

.PHONY: all clean test

all: $(SERVER_OUT) $(CLIENT_OUT) $(LOGGER_OUT)

$(SERVER_OUT): $(SERVER_SRCS)
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)

$(CLIENT_OUT): $(CLIENT_SRCS)
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)

$(LOGGER_OUT): $(LOGGER_SRCS)
	$(CC) $(CFLAGS) -o $@ $^

test: $(TEST_OUT)
	./$(TEST_OUT)

$(TEST_OUT): $(TEST_SRCS)
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)

tsan: $(TEST_SRCS)
	$(CC) $(CFLAGS) -fsanitize=thread -o crdt_test_tsan $^ $(LIBS)
	./crdt_test_tsan

clean:
	rm -f $(SERVER_OUT) $(CLIENT_OUT) $(LOGGER_OUT) $(TEST_OUT) crdt_test_tsan server.log document.bin